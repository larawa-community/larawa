APP_NAME=LaraWA
# Enables the Docker Compose PostgreSQL service profile.
COMPOSE_PROFILES=postgres
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Laravel database connection settings for the PostgreSQL container.
DB_CONNECTION=pgsql
DB_DATABASE=larawa
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=larawa
DB_PASSWORD=secret

# PostgreSQL container bootstrap values; keep these aligned with DB_* above.
POSTGRES_DB=larawa
POSTGRES_USER=larawa
POSTGRES_PASSWORD=secret

# This PostgreSQL-only sample keeps Laravel sessions, queues, and cache database-backed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis connection defaults are kept for completeness, but this sample does not use Redis-backed services.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

LARAWA_DEFAULT_WORKSPACE=LaraWA
LARAWA_INSTALLED=false

WA_WORKER_URL=http://wa-worker:3001
WA_WORKER_INTERNAL_TOKEN=change-me-worker-token
WA_WORKER_CALLBACK_URL=http://nginx/api/internal/worker/events
WA_WORKER_CALLBACK_ATTEMPTS=6
WA_WORKER_CALLBACK_RETRY_DELAY_MS=1500
WA_WORKER_SHUTDOWN_TIMEOUT_MS=25000
WA_WORKER_JSON_BODY_LIMIT=50mb
WA_WORKER_MEDIA_URL_MAX_BYTES=26214400
WA_WORKER_MEDIA_BASE64_MAX_BYTES=26214400
WA_WORKER_MEDIA_URL_MAX_REDIRECTS=3

API_RATE_LIMIT_PER_MINUTE=120
LARAWA_MEDIA_BASE64_MAX_BYTES=26214400
MEDIA_URL_ALLOW_PRIVATE=false
WEBHOOK_URL_ALLOW_PRIVATE=false
WEBHOOK_TIMEOUT=10
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF=30,120,300

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
